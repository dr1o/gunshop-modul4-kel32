#!/bin/sh
# Enforce Conventional Commits v1.0.0
# https://www.conventionalcommits.org/en/v1.0.0/

msg_file="$1"
first_line=$(head -n1 "$msg_file")

# Skip merge commits (git generates these, not conventional)
case "$first_line" in
  Merge\ *|"Merge branch"*) exit 0 ;;
esac

if ! printf '%s\n' "$first_line" | grep -Eq '^[a-zA-Z]+(\([a-zA-Z0-9 _.-]+\))?!?: .+'; then
  echo "error: commit message does not follow Conventional Commits v1.0.0" >&2
  echo "  format: <type>[optional scope][!]: <description>" >&2
  echo "  example: feat(auth): add login" >&2
  exit 1
fi
